{
  "name": "phos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --config ./.oxfmtrc.json --check .",
    "format:fix": "oxfmt --config ./.oxfmtrc.json --write .",
    "lint": "oxlint -c oxlint.json --tsconfig tsconfig.json",
    "lint:fix": "oxlint -c oxlint.json --tsconfig tsconfig.json --fix",
    "knip": "knip",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "next": "16.2.4",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "latest",
    "knip": "^5",
    "oxfmt": "latest",
    "oxlint": "latest",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

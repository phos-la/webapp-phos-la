{
  "name": "phos-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "oxfmt --config ./.oxfmtrc.json --check .",
    "format:fix": "oxfmt --config ./.oxfmtrc.json --write .",
    "lint": "oxlint -c oxlint.json --tsconfig tsconfig.json",
    "lint:fix": "oxlint -c oxlint.json --tsconfig tsconfig.json --fix",
    "knip": "knip",
    "typecheck": "tsgo --noEmit",
    "check:sitemap": "bun run scripts/check-sitemap-coverage.ts",
    "seed": "SANITY_API_TOKEN=$(grep SANITY_API_TOKEN .env.local | cut -d= -f2-) bun run scripts/seed-sanity.ts",
    "seed:images": "SANITY_API_TOKEN=$(grep SANITY_API_TOKEN .env.local | cut -d= -f2-) bun run scripts/seed-sanity-images.ts"
  },
  "dependencies": {
    "@apideck/agent-analytics": "^0.9.0",
    "@portabletext/react": "^3.1.0",
    "@portabletext/types": "^4.0.2",
    "@sanity/client": "^7.22.0",
    "@sanity/image-url": "^2.1.1",
    "@sentry/nextjs": "^10.58.0",
    "@xyflow/react": "^12.10.2",
    "next": "16.2.4",
    "next-sanity": "^12.4.0",
    "posthog-js": "^1.386.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.4",
    "sanity": "^5.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25.6.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native-preview": "latest",
    "knip": "^5",
    "oxfmt": "latest",
    "oxlint": "latest",
    "postcss": "^8",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
